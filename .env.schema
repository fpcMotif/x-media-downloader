# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Dev-only Convex URL for pre-seeding popup Convex sync configuration in DEV mode.
# @type=url
WXT_CONVEX_URL=

# Dev-only Convex secret for pre-seeding popup Convex sync secret in DEV mode.
# @sensitive
WXT_CONVEX_SECRET=

# Google Drive OAuth Client ID for cloud sync dev pre-seeding.
WXT_GDRIVE_CLIENT_ID=

# Dropbox OAuth App Key for cloud sync dev pre-seeding.
WXT_DROPBOX_APP_KEY=

# Shared secret for authenticating extension sync requests in backend Convex deployment.
# @sensitive
SYNC_SHARED_SECRET=

# Convex Deployment identifier used for backend dev & deployment.
# @auditIgnore
CONVEX_DEPLOYMENT=

# Convex Deployment API URL.
# @type=url @auditIgnore
CONVEX_URL=

# Convex HTTP site URL.
# @type=url @auditIgnore
CONVEX_SITE_URL=

# CI environment indicator.
# @type=boolean @auditIgnore
CI=

# Vite/WXT build-time dev environment indicator.
# @type=boolean @auditIgnore
DEV=
