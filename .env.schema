# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Dev-only Convex URL for pre-seeding popup Convex sync configuration in DEV mode.
# @type=url
WXT_CONVEX_URL=

# Dev-only Convex secret for pre-seeding popup Convex sync secret in DEV mode.
# @sensitive
WXT_CONVEX_SECRET=

# Google Drive OAuth Client ID for cloud sync dev pre-seeding.
WXT_GDRIVE_CLIENT_ID=

# Dropbox OAuth App Key for cloud sync dev pre-seeding.
WXT_DROPBOX_APP_KEY=

# Shared secret for authenticating extension sync requests in backend Convex deployment.
# @sensitive
SYNC_SHARED_SECRET=

# Convex Deployment identifier used for backend dev & deployment.
# @auditIgnore
CONVEX_DEPLOYMENT=

# Convex Deployment API URL.
# @type=url @auditIgnore
CONVEX_URL=

# Convex HTTP site URL.
# @type=url @auditIgnore
CONVEX_SITE_URL=

# Default-off deployment-only Drive relay experiment.
# @type=boolean
RELAY_ENABLED=

# Deployment-only Google OAuth client ID.
RELAY_DRIVE_CLIENT_ID=

# Deployment-only Google OAuth client secret.
# @sensitive
RELAY_DRIVE_CLIENT_SECRET=

# Deployment-only Google OAuth refresh token. Never copied from the extension.
# @sensitive
RELAY_DRIVE_REFRESH_TOKEN=

# Deployment-only Drive destination root folder.
RELAY_DRIVE_FOLDER_ID=

# Relay maximum source bytes (default 512 MiB).
# @type=number
RELAY_MAX_BYTES=

# Relay maximum elapsed time in milliseconds (default one hour).
# @type=number
RELAY_MAX_ELAPSED_MS=

# Relay maximum failures (default three).
# @type=number
RELAY_MAX_RETRIES=

# CI environment indicator.
# @type=boolean @auditIgnore
CI=

# Vite/WXT build-time dev environment indicator.
# @type=boolean @auditIgnore
DEV=
