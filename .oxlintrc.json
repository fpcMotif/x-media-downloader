{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y", "vitest", "jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "browser": true,
    "webextensions": true,
    "serviceworker": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "fc.assert"] }],
    "jsdoc/check-tag-names": ["error", { "definedTags": ["defaultValue", "remarks"], "typed": true }]
  },
  "overrides": [
    {
      "files": ["**/inject.content.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "promise/always-return": "off",
        "promise/prefer-await-to-then": "off",
        "promise/no-nesting": "off"
      }
    }
  ],
  "ignorePatterns": [".output", ".wxt", "study", ".agents", ".claude", "backend", "src/components/ui", "tools/anti-slop"]
}
