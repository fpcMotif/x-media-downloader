{
  "name": "x-media-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Minimalist, extensible Chrome extension to download X (Twitter) tweet/thread media at original quality.",
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "dev": "varlock run -- wxt",
    "build": "varlock run -- wxt build",
    "prepare": "varlock codegen && wxt prepare",
    "typecheck": "bun --bun wxt prepare && bun check --no-script",
    "lint": "bun lint --no-script",
    "lint:ci": "bun lint --no-script --deny-warnings",
    "lint:boundaries": "bun scripts/lint-boundaries.ts",
    "lint:complexity": "bun lint --no-script -c .oxlintrc.complexity.json --no-type-aware",
    "fmt": "bun fmt --no-script src",
    "fmt:check": "bun fmt --no-script --check src",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --format text",
    "test": "varlock run -- vitest run",
    "test:watch": "varlock run -- vitest",
    "test:coverage": "varlock run -- vitest run --coverage",
    "test:backend": "cd backend && varlock run -- bun run test",
    "test:all": "varlock run -- vitest run && cd backend && varlock run -- bun run test",
    "env:codegen": "varlock codegen",
    "env:audit": "varlock audit src backend",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "visual:frameshift": "bun run scripts/frameshift-visual-qa.ts",
    "check": "bun fmt --no-script --check src && bun lint --no-script --deny-warnings && varlock audit src backend && bun --bun wxt prepare && bun check --no-script && bun scripts/lint-boundaries.ts && vitest run",
    "parity:capture": "bun run scripts/parity.ts capture --config scripts/parity.config.json",
    "parity:compare": "bun run scripts/parity.ts compare --config scripts/parity.config.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@stylexjs/stylex": "0.19.1",
    "effect": "^4.0.2",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint-plugin-jsdoc": "^65.5.0",
    "fast-check": "4.10.2",
    "happy-dom": "^20.14.6",
    "oxc-parser": "^0.153.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "portless": "^0.15.7",
    "typescript": "next",
    "varlock": "^1.21.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
