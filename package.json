{
  "name": "x-media-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome extension for original-quality media from X, Instagram, and Threads.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsgo --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --deny-warnings",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --format text",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "cd backend && ./node_modules/.bin/vitest run",
    "test:all": "vitest run && cd backend && ./node_modules/.bin/vitest run",
    "check": "oxfmt --check src && oxlint && wxt prepare && tsgo --noEmit && vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "effect": "4.0.0-beta.92",
    "lucide-react": "^0.469.0",
    "preact": "^10.29.2",
    "radix-ui": "^1.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "@vitest/coverage-v8": "4.1.9",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wxt": "0.20.27"
  },
  "patchedDependencies": {
    "wxt@0.20.27": "patches/wxt@0.20.27.patch"
  }
}
