{
  "name": "x-media-downloader",
  "description": "Minimalist, extensible Chrome extension to download X (Twitter) tweet/thread media at original quality.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "varlock run -- wxt",
    "build": "varlock run -- wxt build",
    "prepare": "varlock codegen && wxt prepare",
    "typecheck": "wxt prepare && tsgo --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --deny-warnings",
    "lint:boundaries": "depcruise src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --format text",
    "test": "varlock run -- vitest run",
    "test:watch": "varlock run -- vitest",
    "test:coverage": "varlock run -- vitest run --coverage",
    "test:backend": "cd backend && varlock run -- bun run test",
    "test:all": "varlock run -- vitest run && cd backend && varlock run -- bun run test",
    "env:codegen": "varlock codegen",
    "env:audit": "varlock audit src backend",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "check": "oxfmt --check src && oxlint && varlock audit src backend && wxt prepare && tsgo --noEmit && depcruise src && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "effect": "^4.0.0-beta.92",
    "lucide-react": "^0.469.0",
    "preact": "^10.29.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "^18.1.0",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "varlock": "^1.16.0",
    "vitest": "^4.1.9",
    "wxt": "^0.20.26"
  },
  "patchedDependencies": {
    "wxt@0.20.26": "patches/wxt@0.20.26.patch"
  }
}
