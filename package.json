{
  "name": "x-media-downloader",
  "description": "Minimalist, extensible Chrome extension to download X (Twitter) tweet/thread media at original quality.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "varlock run -- wxt",
    "build": "varlock run -- wxt build",
    "prepare": "varlock codegen && wxt prepare",
    "typecheck": "wxt prepare && tsgo --noEmit",
    "lint": "oxlint --type-aware",
    "lint:ci": "oxlint --type-aware --deny-warnings",
    "lint:boundaries": "bun scripts/lint-boundaries.ts",
    "lint:complexity": "oxlint -c .oxlintrc.complexity.json --disable-nested-config",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --format text",
    "test": "varlock run -- vitest run",
    "test:watch": "varlock run -- vitest",
    "test:coverage": "varlock run -- vitest run --coverage",
    "test:backend": "cd backend && varlock run -- bun run test",
    "test:all": "varlock run -- vitest run && cd backend && varlock run -- bun run test",
    "env:codegen": "varlock codegen",
    "env:audit": "varlock audit src backend",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "check": "oxfmt --check src && oxlint --type-aware && varlock audit src backend && wxt prepare && tsgo --noEmit && bun scripts/lint-boundaries.ts && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.1.0",
    "effect": "^4.0.0-beta.92",
    "lucide-react": "^1.37.0",
    "preact": "^10.29.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "happy-dom": "^20.12.0",
    "oxc-parser": "^0.148.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "varlock": "^1.17.1",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
